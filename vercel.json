{
    "version": 2,
    "functions": {
        "app.py": {
            "maxDuration": 15
        }
    },
    "builds": [
        {
            "src": "app.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "app.py"
        }
    ]
}